# Dev defaults. Leave VITE_API_URL empty so apiClient calls are relative
# and hit the Vite dev proxy (/api -> :8100). For a deployed build, set it
# to the backend origin (e.g. VITE_API_URL="https://api.example.com").
VITE_API_URL=""

# Active client comes from src/tenants/active.ts (npm run client -- <name>)
# — do NOT set VITE_CLIENT here, it would override the generated file.
# VITE_CLIENT="hello"
