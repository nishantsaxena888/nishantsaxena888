{
  "meta": {
    "title": "Learn \u2014 Skillom"
  },
  "config": [
    {
      "id": "chapter-reader",
      "type": "chapter-reader",
      "properties": {
        "level": "base",
        "type": "dynamic",
        "action": [
          {
            "key": "chapter",
            "endpoint": "chapter/:id",
            "method": "GET"
          },
          {
            "key": "revisions",
            "endpoint": "revision",
            "method": "GET",
            "queryParams": {
              "chapter_id": ":id",
              "size": 100
            }
          },
          {
            "key": "submit_quiz",
            "endpoint": "quiz_submission",
            "method": "POST",
            "lazy": true,
            "payload": {
              "chapter_id": ":chapter_id",
              "quiz_id": ":quiz_id",
              "score": ":score",
              "total": ":total"
            }
          }
        ]
      },
      "content": {
        "title": "Chapter"
      }
    }
  ]
}
