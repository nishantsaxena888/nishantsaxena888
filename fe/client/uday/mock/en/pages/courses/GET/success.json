{
  "meta": {
    "title": "Courses \u2014 Uday"
  },
  "config": [
    {
      "id": "course-grid",
      "type": "course-list",
      "properties": {
        "level": "base",
        "type": "dynamic",
        "action": [
          {
            "key": "data",
            "endpoint": "course",
            "method": "GET",
            "queryParams": {
              "size": 100
            }
          },
          {
            "key": "categories",
            "endpoint": "category",
            "method": "GET",
            "queryParams": {
              "size": 50
            }
          },
          {
            "key": "chapters",
            "endpoint": "chapter",
            "method": "GET",
            "queryParams": {
              "size": 500
            }
          }
        ]
      },
      "content": {
        "title": "All Courses",
        "detail_path": "/courses",
        "back": {
          "label": "\u2190 Back to Course",
          "to": "/"
        },
        "entity": "course",
        "card_actions": [
          {
            "icon": "\u270f\ufe0f",
            "label": "Edit",
            "opens": "detail",
            "method": "put"
          },
          {
            "icon": "\ud83d\uddd1",
            "label": "Delete",
            "method": "delete",
            "confirm": "Delete {title}?"
          }
        ],
        "show_status": false,
        "filter_note": false,
        "meta_icon": "\ud83d\udcc4",
        "category_eyebrow": "Course Category"
      }
    }
  ]
}
