{
  "meta": {
    "title": "Learn \u2014 Uday"
  },
  "config": [
    {
      "id": "chapter-reader",
      "type": "chapter-reader",
      "properties": {
        "level": "base",
        "type": "dynamic",
        "action": [
          {
            "key": "chapter",
            "endpoint": "chapter/:id",
            "method": "GET"
          },
          {
            "key": "revisions",
            "endpoint": "revision",
            "method": "GET",
            "queryParams": {
              "chapter_id": ":id",
              "size": 100
            }
          },
          {
            "key": "chapters",
            "endpoint": "chapter",
            "method": "GET",
            "queryParams": {
              "size": 500
            }
          },
          {
            "key": "submit_quiz",
            "endpoint": "quiz_submission",
            "method": "POST",
            "lazy": true,
            "payload": {
              "chapter_id": ":chapter_id",
              "quiz_id": ":quiz_id",
              "score": ":score",
              "total": ":total"
            }
          },
          {
            "key": "save_notes",
            "endpoint": "lab_note",
            "method": "POST",
            "lazy": true,
            "payload": {
              "chapter_id": ":chapter_id",
              "body": ":body"
            }
          }
        ]
      },
      "content": {
        "title": "Chapter",
        "back_path": "/courses",
        "toc": true,
        "topbar": {
          "logo": "\ud83d\ude80 Masterclass",
          "title_tpl": "Chapter {no}: {title}",
          "home": "/",
          "dark_theme": "uday-dark",
          "light_theme": "default"
        },
        "reader_path": "/chapter"
      }
    }
  ]
}
