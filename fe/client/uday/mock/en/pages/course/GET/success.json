{
  "meta": {
    "title": "Course \u2014 Uday"
  },
  "config": [
    {
      "id": "course-detail",
      "type": "course-detail",
      "properties": {
        "level": "base",
        "type": "dynamic",
        "action": [
          {
            "key": "course",
            "endpoint": "course/:id",
            "method": "GET"
          },
          {
            "key": "chapters",
            "endpoint": "chapter",
            "method": "GET",
            "queryParams": {
              "course_id": ":id",
              "size": 200
            }
          },
          {
            "key": "enroll",
            "endpoint": "enrollment",
            "method": "POST",
            "lazy": true,
            "payload": {
              "course_id": ":id",
              "status": "active",
              "enrolled_at": ":at"
            }
          }
        ]
      },
      "content": {
        "title": "Course",
        "reader_path": "/chapter",
        "row_actions": [
          {
            "icon": "\u270f\ufe0f",
            "label": "Edit",
            "opens": "detail",
            "method": "put"
          },
          {
            "icon": "\ud83d\uddd1",
            "label": "Delete",
            "method": "delete",
            "confirm": "Delete {title}?"
          }
        ]
      }
    }
  ]
}
