    "course": {
      "meta": {
        "title": "Course \u2014 Uday"
      },
      "config": [
        {
          "id": "course-detail",
          "type": "course-detail",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "course",
                "endpoint": "course/:id",
                "method": "GET"
              },
              {
                "key": "chapters",
                "endpoint": "chapter",
                "method": "GET",
                "queryParams": {
                  "course_id": ":id",
                  "size": 200
                }
              },
              {
                "key": "enroll",
                "endpoint": "enrollment",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "course_id": ":id",
                  "status": "active",
                  "enrolled_at": ":at"
                }
              }
            ]
          },
          "content": {
            "title": "Course",
            "reader_path": "/learn"
          }
        }
      ]
    },
    "learn": {
      "meta": {
        "title": "Learn \u2014 Uday"
      },
      "config": [
        {
          "id": "chapter-reader",
          "type": "chapter-reader",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "chapter",
                "endpoint": "chapter/:id",
                "method": "GET"
              },
              {
                "key": "revisions",
                "endpoint": "revision",
                "method": "GET",
                "queryParams": {
                  "chapter_id": ":id",
                  "size": 100
                }
              },
              {
                "key": "chapters",
                "endpoint": "chapter",
                "method": "GET",
                "queryParams": {
                  "size": 500
                }
              },
              {
                "key": "submit_quiz",
                "endpoint": "quiz_submission",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "chapter_id": ":chapter_id",
                  "quiz_id": ":quiz_id",
                  "score": ":score",
                  "total": ":total"
                }
              },
              {
                "key": "save_notes",
                "endpoint": "lab_note",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "chapter_id": ":chapter_id",
                  "body": ":body"
                }
              }
            ]
          },
          "content": {
            "title": "Chapter",
            "back_path": "/courses",
            "toc": true
          }
        }
      ]
    },
    "my-learning": {
      "meta": {
        "title": "My Learning \u2014 Uday"
