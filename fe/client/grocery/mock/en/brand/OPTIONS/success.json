{
  "meta": {
    "title": "Brand Management",
    "description": "Configure and manage product brands."
  },
  "content": {
    "table": {
      "columns": [
        { "key": "id", "label": "ID", "type": "text" },
        { "key": "name", "label": "Brand Name", "type": "text" },
        { "key": "description", "label": "Description", "type": "text" },
        { "key": "status", "label": "Status", "type": "status" }
      ]
    },
    "form": {
      "id": "brand-form",
      "title": "Brand Details",
      "layout": "default",
      "columns": 2,
      "inputs": [
        { "name": "name", "label": "Brand Name", "type": "text", "column": { "md": 6 }, "validation": [{ "rule": "required" }] },
        { "name": "status", "label": "Status", "type": "select", "defaultValue": "active", "column": { "md": 6 }, "options": [ { "label": "Active", "value": "active" }, { "label": "Inactive", "value": "inactive" } ] },
        { "name": "description", "label": "Description", "type": "textarea", "column": { "md": 12 } }
      ]
    }
  }
}
