{
  "meta": {
    "title": "Sales Orders",
    "description": "Track customer purchases, fulfillment status, and payment processing."
  },
  "content": {
    "table": {
      "columns": [
        {
          "label": "Order ID",
          "key": "order_number",
          "type": "badge",
          "styles": {
            "variant": "outline",
            "className": "font-mono font-bold"
          },
          "sortable": true,
          "searchable": true
        },
        {
          "label": "Customer",
          "key": "customer_name",
          "type": "text",
          "sortable": true,
          "searchable": true
        },
        {
          "label": "Date",
          "key": "order_date",
          "type": "text",
          "sortable": true
        },
        {
          "label": "Total",
          "key": "total_amount",
          "type": "text",
          "styles": {
             "className": "font-bold text-slate-900"
          }
        },
        {
          "label": "Payment",
          "key": "payment_status",
          "type": "status",
          "options": {
            "paid": { "label": "Paid", "variant": "success" },
            "pending": { "label": "Pending", "variant": "warning" },
            "failed": { "label": "Failed", "variant": "destructive" },
            "refunded": { "label": "Refunded", "variant": "secondary" }
          }
        },
        {
          "label": "Fulfillment",
          "key": "status",
          "type": "status",
          "options": {
            "delivered": { "label": "Delivered", "variant": "success" },
            "shipped": { "label": "Shipped", "variant": "info" },
            "processing": { "label": "Processing", "variant": "warning" },
            "cancelled": { "label": "Cancelled", "variant": "destructive" }
          }
        }
      ],
      "actions": [
        {
          "id": "view-order",
          "label": "View Invoice",
          "type": "button",
          "action": "open_link",
          "variant": "outline",
          "icon": "FileText"
        }
      ]
    },
    "form": {
      "title": "Sales Order Details",
      "description": "Configure order items, shipping details, and billing information.",
      "formType": "simple",
      "inputs": [
        {
          "name": "order_number",
          "label": "Order Number",
          "type": "text",
          "placeholder": "ORD-XXXX",
          "column": { "md": 6 },
          "validation": [{ "rule": "required" }]
        },
        {
          "name": "order_date",
          "label": "Transaction Date",
          "type": "date",
          "column": { "md": 6 },
          "validation": [{ "rule": "required" }]
        },
        {
          "name": "customer_id",
          "label": "Customer",
          "type": "dynamic-select",
          "column": { "md": 12 },
          "config": { "endpoint": "customer", "bindLabel": "name", "bindValue": "id" },
          "validation": [{ "rule": "required" }]
        },
        {
          "name": "total_amount",
          "label": "Grand Total",
          "type": "number",
          "placeholder": "0.00",
          "column": { "md": 6 },
          "validation": [{ "rule": "required" }]
        },
        {
          "name": "payment_method",
          "label": "Payment Method",
          "type": "select",
          "column": { "md": 6 },
          "options": [
            { "label": "Credit Card", "value": "card" },
            { "label": "Bank Transfer", "value": "bank" },
            { "label": "Cash", "value": "cash" },
            { "label": "UPI", "value": "upi" }
          ]
        },
        {
          "name": "payment_status",
          "label": "Payment Status",
          "type": "select",
          "column": { "md": 6 },
          "options": [
            {"label": "Pending", "value": "pending"},
            {"label": "Paid", "value": "paid"},
            {"label": "Failed", "value": "failed"},
            {"label": "Refunded", "value": "refunded"}
          ]
        },
        {
          "name": "status",
          "label": "Fulfillment Status",
          "type": "select",
          "column": { "md": 6 },
          "options": [
            {"label": "Processing", "value": "processing"},
            {"label": "Shipped", "value": "shipped"},
            {"label": "Delivered", "value": "delivered"},
            {"label": "Cancelled", "value": "cancelled"}
          ]
        },
        {
          "name": "notes",
          "label": "Internal Notes",
          "type": "textarea",
          "placeholder": "Add any internal shipping or billing notes...",
          "column": { "md": 12 }
        }
      ]
    }
  }
}
