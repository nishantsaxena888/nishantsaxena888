    {
      "name": "cart",
      "source": "session",
      "persist": true,
      "method": "array_upsert",
      "method_config": {
        "match_key": "id",
        "on_match": "increment",
        "increment_field": "qty",
        "default_fields": { "qty": 1 }
      },
      "field_mapping": {
        "id": "id",
        "unit_price": "price",
        "name": "name",
        "image": "image"
      }
    },
    {
      "name": "wishlist",
