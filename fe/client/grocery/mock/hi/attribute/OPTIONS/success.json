{
  "meta": {
    "title": "विशेषता प्रबंधन",
    "description": "उत्पाद विशेषताओं को परिभाषित और प्रबंधित करें।"
  },
  "name": "attribute",
  "config": [
    {
      "id": "attribute-admin-module",
      "type": "default-admin",
      "properties": {
        "level": "base",
        "type": "dynamic",
        "actions": [
          {
            "key": "data",
            "endpoint": "/attribute",
            "method": "get",
            "queryParams": {},
            "responseMapping": {}
          }
        ]
      },
      "content": {
        "table": {
          "columns": [
            {
              "key": "id",
              "label": "आईडी",
              "type": "text",
              "sortable": true
            },
            {
              "key": "name",
              "label": "नाम",
              "type": "text",
              "sortable": true,
              "searchable": true
            },
            {
              "key": "status",
              "label": "स्थिति",
              "type": "status",
              "options": {
                "active": { "label": "सक्रिय", "variant": "success" },
                "inactive": { "label": "निष्क्रिय", "variant": "destructive" }
              }
            }
          ],
          "actions": [
            {
              "id": "edit-attr",
              "label": "संपादन",
              "type": "button",
              "action": "open_form",
              "variant": "ghost",
              "icon": "EditIcon"
            },
            {
              "id": "delete-attr",
              "label": "हटाएं",
              "type": "button",
              "action": "confirm_delete",
              "variant": "destructive",
              "icon": "TrashIcon"
            }
          ]
        },
        "form": {
          "id": "attribute-form",
          "title": "विशेषता विवरण",
          "layout": "default",
          "columns": 2,
          "fields": [
            {
              "name": "name",
              "label": "विशेषता का नाम",
              "componentType": "TextInput",
              "required": true,
              "placeholder": "जैसे: रंग, आकार...",
              "colSpan": 1
            },
            {
              "name": "status",
              "label": "स्थिति",
              "componentType": "Select",
              "defaultValue": "active",
              "colSpan": 1,
              "options": [
                { "label": "सक्रिय", "value": "active" },
                { "label": "निष्क्रिय", "value": "inactive" }
              ]
            }
          ]
        }
      },
      "children": []
    }
  ]
}
