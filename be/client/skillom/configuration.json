{
  "meta": {
    "client": "skillom",
    "display_name": "Skillom",
    "theme": "skillom-light",
    "language": "en"
  },
  "admin": {
    "require_auth": false,
    "login_redirect": "/admin/course",
    "logout_redirect": "/"
  },
  "menu": [
    {
      "name": "Home",
      "description": "Course catalog",
      "url": "/",
      "entity": "home",
      "public": true,
      "order": 0
    },
    {
      "name": "Courses",
      "description": "All courses",
      "url": "/courses",
      "entity": "pages/courses",
      "public": true,
      "order": 1
    },
    {
      "name": "Course",
      "description": "Course detail",
      "url": "/courses/:id",
      "entity": "pages/course",
      "public": true,
      "hide": true,
      "order": 5
    },
    {
      "name": "Learn",
      "description": "Chapter reader",
      "url": "/learn/:id",
      "entity": "pages/learn",
      "public": true,
      "hide": true,
      "order": 6
    },
    {
      "name": "My Learning",
      "description": "Progress & bookmarks",
      "url": "/my-learning",
      "entity": "my-learning",
      "public": true,
      "order": 2
    },
    {
      "name": "Login",
      "description": "Sign in",
      "url": "/login",
      "entity": "login",
      "public": true,
      "order": 3,
      "auth_page": true,
      "hide": true
    },
    {
      "name": "Signup",
      "description": "Create account",
      "url": "/register",
      "entity": "register",
      "public": true,
      "order": 4,
      "auth_page": true,
      "hide": true
    }
  ],
  "admin_menu": [
