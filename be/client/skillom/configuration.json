  ],
  "language": [
    {
      "name": "English",
      "code": "en"
    },
    {
      "name": "Hindi",
      "code": "hi"
    }
  ],
  "sessions": [
    {
      "name": "progress",
      "persist": true,
      "method": "array_upsert",
      "method_config": {
        "match_key": "id"
      }
    },
    {
      "name": "bookmark",
      "persist": true,
      "method": "array_toggle",
      "method_config": {
        "match_key": "id"
      }
    },
    {
      "name": "recent",
      "persist": true,
      "method": "array_prepend_unique",
      "method_config": {
        "match_key": "id",
        "limit": 12
      }
    }
  ],
  "pages": {
    "courses": {
      "meta": {
        "title": "Courses — Skillom"
      },
      "config": [
        {
          "id": "course-grid",
          "type": "course-list",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "data",
                "endpoint": "course",
                "method": "GET",
                "queryParams": {
                  "size": 100
                }
              },
              {
                "key": "categories",
                "endpoint": "category",
                "method": "GET",
                "queryParams": {
                  "size": 50
                }
              },
              {
                "key": "chapters",
                "endpoint": "chapter",
                "method": "GET",
                "queryParams": {
                  "size": 500
                }
              }
            ]
          },
          "content": {
            "title": "All Courses",
            "cta_label": "Open course"
          }
        }
      ]
    },
    "course": {
      "meta": {
        "title": "Course — Skillom"
      },
      "config": [
        {
          "id": "course-detail",
          "type": "course-detail",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "course",
                "endpoint": "course/:id",
                "method": "GET"
              },
              {
                "key": "chapters",
                "endpoint": "chapter",
                "method": "GET",
                "queryParams": {
                  "course_id": ":id",
                  "size": 200
                }
              },
              {
                "key": "enroll",
                "endpoint": "enrollment",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "course_id": ":id",
                  "status": "active",
                  "enrolled_at": ":at"
                }
              }
            ]
          },
          "content": {
            "title": "Course"
          }
        }
      ]
    },
    "learn": {
      "meta": {
        "title": "Learn — Skillom"
      },
      "config": [
        {
          "id": "chapter-reader",
          "type": "chapter-reader",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "chapter",
                "endpoint": "chapter/:id",
                "method": "GET"
              },
              {
                "key": "revisions",
                "endpoint": "revision",
                "method": "GET",
                "queryParams": {
                  "chapter_id": ":id",
                  "size": 100
                }
              },
              {
                "key": "chapters",
                "endpoint": "chapter",
                "method": "GET",
                "queryParams": {
                  "size": 500
                }
              },
              {
                "key": "submit_quiz",
                "endpoint": "quiz_submission",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "chapter_id": ":chapter_id",
                  "quiz_id": ":quiz_id",
                  "score": ":score",
                  "total": ":total"
                }
              },
              {
                "key": "save_notes",
                "endpoint": "lab_note",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "chapter_id": ":chapter_id",
                  "body": ":body"
                }
              }
            ]
          },
          "content": {
            "title": "Chapter",
            "toc": true
          }
        }
      ]
    }
  },
  "themes": [
    {
      "value": "skillom",
      "label": "Skillom"
    }
  ],
  "style-configs": {
    "skillom": {
      "name": "Skillom",
      "styles": {
        "primary": "262 83% 58%",
        "primary-foreground": "0 0% 100%",
        "accent": "262 83% 96%",
        "radius": "0.5rem"
      }
    }
  },
