    {
      "name": "Categories",
      "description": "Course categories",
      "url": "/admin/category",
      "entity": "category",
      "icon": "tags"
    },
    {
      "name": "Courses",
      "description": "Course management",
      "url": "/admin/course",
      "entity": "course",
      "icon": "graduation-cap"
    },
    {
      "name": "Chapters",
      "description": "Chapter ordering",
      "url": "/admin/chapter",
      "entity": "chapter",
      "icon": "list"
    },
    {
      "name": "Revisions",
      "description": "Draft / review / publish",
      "url": "/admin/revision",
      "entity": "revision",
      "icon": "git-branch"
    },
    {
      "name": "Review Queue",
      "description": "Draft / review / publish board",
      "url": "/admin/review-queue",
      "entity": "review-queue",
      "icon": "kanban"
    },
    {
      "name": "Comments",
      "description": "Review comments",
      "url": "/admin/comment",
      "entity": "comment",
      "icon": "message-square"
    },
    {
      "name": "Releases",
      "description": "Course snapshots",
      "url": "/admin/course-release",
      "entity": "course_release",
      "icon": "package"
    },
    {
      "name": "Enrollments",
      "description": "Learner enrollment",
      "url": "/admin/enrollment",
      "entity": "enrollment",
      "icon": "user-plus"
    },
    {
      "name": "Progress",
      "description": "Section completion",
      "url": "/admin/progress",
      "entity": "progress",
      "icon": "check-circle"
    },
    {
      "name": "Lab Notes",
      "description": "Learner notes",
      "url": "/admin/lab-note",
      "entity": "lab_note",
      "icon": "notebook-pen"
    },
    {
      "name": "Quiz Scores",
