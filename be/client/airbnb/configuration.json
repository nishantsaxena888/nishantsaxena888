              },
              {
                "label": "City",
                "icon": "🏙️",
                "category": "city"
              }
            ]
          }
        },
        {
          "id": "airbnb-stays-1",
          "type": "stay-grid",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "session": "wishlist",
            "action": [
              {
                "key": "data",
                "endpoint": "listing",
                "method": "GET",
