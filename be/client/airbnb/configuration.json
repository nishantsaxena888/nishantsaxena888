{
  "meta": {
    "client": "airbnb",
    "display_name": "Airbnb",
    "theme": "airbnb",
    "language": "en",
    "currency": "INR",
    "currency_symbol": "₹"
  },
  "home_page": "pages/home",
  "admin": {
    "require_auth": false,
    "login_redirect": "/admin/overview",
    "logout_redirect": "/"
  },
  "roles": [
    {
      "name": "viewer",
      "default": true
    },
    {
      "name": "admin"
    }
  ],
  "menu": [
    {
      "name": "Home",
      "description": "Find your stay",
      "url": "/",
      "entity": "pages/home",
      "public": true,
      "order": 0
    },
    {
      "name": "Stays",
      "description": "All stays",
      "url": "/stays",
      "entity": "pages/stays",
      "public": true,
      "order": 1
    },
    {
      "name": "Wishlists",
      "description": "Saved stays",
      "url": "/wishlist",
      "entity": "pages/wishlist",
      "public": true,
      "order": 2
    },
    {
      "name": "Stay",
      "description": "Stay detail",
      "url": "/stays/:id",
      "entity": "pages/stay",
      "public": true,
      "hide": true,
      "order": 3
    }
  ],
  "admin_menu": [
    {
      "name": "Overview",
      "description": "Business snapshot",
      "url": "/admin/overview",
      "entity": "overview",
      "icon": "layout-dashboard"
    },
    {
      "name": "Listings",
      "description": "Stay catalogue",
      "url": "/admin/listing",
      "entity": "listing",
      "icon": "home"
    },
    {
      "name": "Hosts",
      "description": "Host directory",
      "url": "/admin/host",
      "entity": "host",
      "icon": "user"
    },
    {
      "name": "Bookings",
      "description": "Reservations",
      "url": "/admin/booking",
      "entity": "booking",
      "icon": "calendar"
    },
    {
      "name": "Reviews",
      "description": "Guest reviews",
      "url": "/admin/review",
      "entity": "review",
      "icon": "star"
    },
    {
      "name": "Amenities",
      "description": "Amenity catalogue",
      "url": "/admin/amenity",
      "entity": "amenity",
      "icon": "sparkles"
    }
  ],
  "language": [
    {
      "name": "English",
      "code": "en"
    },
    {
      "name": "Hindi",
      "code": "hi"
    }
  ],
  "sessions": [
    {
      "name": "wishlist",
      "persist": true,
      "method": "array_toggle",
      "method_config": {
        "match_key": "id"
      }
    },
    {
      "name": "trips",
      "persist": true,
      "method": "array_upsert",
      "method_config": {
        "match_key": "id"
      }
    }
  ],
  "themes": [
    {
      "value": "airbnb",
      "label": "Airbnb",
      "endpoint": "style-config/airbnb"
    },
    {
      "value": "default",
      "label": "Default",
      "endpoint": "style-config/default"
    }
  ],
