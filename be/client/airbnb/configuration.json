        {
          "id": "airbnb-stays-2",
          "type": "stay-grid",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "session": "wishlist",
            "action": [
              {
                "key": "data",
                "endpoint": "listing",
                "method": "GET",
                "queryParams": {
                  "size": 50
