    "wishlist": {
      "meta": {
        "title": "Wishlists"
      },
      "config": [
        {
          "id": "airbnb-wishlist-1",
          "type": "stay-grid",
          "properties": {
            "level": "base",
            "type": "static",
            "source": "session:wishlist"
