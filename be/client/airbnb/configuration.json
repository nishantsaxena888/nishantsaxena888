      "config": [
        {
          "id": "airbnb-hero-1",
          "type": "banner",
          "properties": {
            "level": "base",
            "type": "static"
          },
          "content": {
            "headline": "Find a place you'll love to stay",
            "subheadline": "Villas, cabins, houseboats and city lofts — hosted by people who care.",
            "badge": "Over 8 unique stays live",
            "cta": "Explore stays",
            "ctaUrl": "/stays",
            "explore": "See wishlists",
            "exploreUrl": "/wishlist",
            "image": "https://picsum.photos/seed/airbnb-hero/900/600"
          }
        },
        {
