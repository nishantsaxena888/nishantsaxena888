      "public": true,
      "order": 1
    },
    {
      "name": "Course",
      "description": "Course detail",
      "url": "/courses/:id",
      "entity": "pages/course",
      "public": true,
      "hide": true,
      "order": 2
    },
    {
      "name": "Learn",
      "description": "Chapter reader",
      "url": "/learn/:id",
      "entity": "pages/learn",
      "public": true,
      "hide": true,
      "order": 3
    },
    {
      "name": "My Learning",
      "description": "Progress & bookmarks",
      "url": "/my-learning",
