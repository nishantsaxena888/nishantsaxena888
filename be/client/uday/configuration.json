  "language": [
    {
      "name": "English",
      "code": "en"
    },
    {
      "name": "Hindi",
      "code": "hi"
    }
  ],
  "sessions": [
    {
      "name": "progress",
      "persist": true,
      "method": "array_upsert",
      "method_config": {
        "match_key": "id"
      }
    },
    {
      "name": "bookmark",
      "persist": true,
      "method": "array_toggle",
      "method_config": {
        "match_key": "id"
      }
    },
    {
      "name": "recent",
      "persist": true,
      "method": "array_prepend_unique",
      "method_config": {
        "match_key": "id",
        "limit": 12
      }
    }
  ],
  "themes": [
    {
      "value": "uday-dark",
      "label": "Uday Dark",
      "endpoint": "style-config/uday-dark"
    },
    {
      "value": "default",
      "label": "Default",
      "endpoint": "style-config/default"
    }
  ],
