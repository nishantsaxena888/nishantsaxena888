      "public": true,
      "order": 4
    },
    {
      "name": "Login",
      "description": "Sign in",
      "url": "/login",
      "entity": "login",
      "public": true,
      "order": 5,
      "auth_page": true,
      "hide": true
    },
    {
      "name": "Signup",
      "description": "Create account",
      "url": "/register",
      "entity": "register",
      "public": true,
      "order": 6,
      "auth_page": true,
      "hide": true
    }
  ],
