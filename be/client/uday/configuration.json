    "currency": "USD",
    "currency_symbol": "$"
  },
  "admin": {
    "require_auth": false,
    "login_redirect": "/admin/course",
    "logout_redirect": "/"
  },
  "menu": [
    {
      "name": "Home",
      "description": "Learning home",
      "url": "/",
