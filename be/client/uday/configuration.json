  "pages": {
    "home": {
      "meta": {
        "title": "Uday Learning"
      },
      "config": [
        {
          "id": "uday-hero-1",
          "type": "uday-hero",
          "properties": {
            "level": "base",
            "type": "static"
          },
          "content": {
            "title": "Learn by building",
            "subtitle": "Markdown-driven courses \u2014 the learning client on the same generic platform."
          }
        },
        {
          "id": "uday-courses-1",
          "type": "course-list",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "data",
                "endpoint": "course",
                "method": "GET",
                "queryParams": {
                  "size": 9
                }
              }
            ]
          },
          "content": {
            "title": "Featured courses",
            "detail_path": "/courses"
          }
        }
      ]
    },
    "courses": {
      "meta": {
        "title": "Courses \u2014 Uday"
      },
      "config": [
        {
          "id": "course-grid",
          "type": "course-list",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "data",
                "endpoint": "course",
                "method": "GET",
                "queryParams": {
                  "size": 100
                }
              }
            ]
          },
          "content": {
            "title": "All Courses",
            "cta_label": "Start learning",
            "detail_path": "/courses"
          }
        }
      ]
    },
    "course": {
      "meta": {
        "title": "Course \u2014 Uday"
      },
      "config": [
        {
          "id": "course-detail",
          "type": "course-detail",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "course",
                "endpoint": "course/:id",
                "method": "GET"
              },
              {
                "key": "chapters",
                "endpoint": "chapter",
                "method": "GET",
                "queryParams": {
                  "course_id": ":id",
                  "size": 200
                }
              },
              {
                "key": "enroll",
                "endpoint": "enrollment",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "course_id": ":id",
                  "status": "active",
                  "enrolled_at": ":at"
                }
              }
            ]
          },
          "content": {
            "title": "Course",
            "reader_path": "/learn"
          }
        }
      ]
    },
    "learn": {
      "meta": {
        "title": "Learn \u2014 Uday"
      },
      "config": [
        {
          "id": "chapter-reader",
          "type": "chapter-reader",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "chapter",
                "endpoint": "chapter/:id",
                "method": "GET"
              },
              {
                "key": "revisions",
                "endpoint": "revision",
                "method": "GET",
                "queryParams": {
                  "chapter_id": ":id",
                  "size": 100
                }
              },
              {
                "key": "submit_quiz",
                "endpoint": "quiz_submission",
                "method": "POST",
                "lazy": true,
                "payload": {
                  "chapter_id": ":chapter_id",
                  "quiz_id": ":quiz_id",
                  "score": ":score",
                  "total": ":total"
                }
              }
            ]
          },
          "content": {
            "title": "Chapter",
            "back_path": "/courses"
          }
        }
      ]
    },
    "my-learning": {
      "meta": {
        "title": "My Learning \u2014 Uday"
      },
      "config": [
        {
          "id": "recent-strip",
          "type": "session-list",
          "properties": {
            "level": "base",
            "type": "static"
          },
          "content": {
            "title": "Recently viewed",
            "session": "recent"
          }
        },
        {
          "id": "progress-list",
          "type": "session-list",
          "properties": {
            "level": "base",
            "type": "static"
          },
          "content": {
            "title": "My progress",
            "session": "progress"
          }
        },
        {
          "id": "bookmark-list",
          "type": "session-list",
          "properties": {
            "level": "base",
            "type": "static"
          },
          "content": {
            "title": "Bookmarks",
            "session": "bookmark"
          }
        }
      ]
    }
  }
}