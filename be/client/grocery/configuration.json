  "pages": {
    "home": {
      "meta": {
        "title": "Grocery"
      },
      "config": [
        {
          "id": "grocery-hero-1",
          "type": "grocery-hero",
          "properties": {
            "level": "base",
            "type": "static"
          },
          "content": {
            "title": "Fresh today",
            "subtitle": "Same engine, different client — this page is a JSON definition served by the backend.",
            "cta": "Shop deals"
          }
        },
        {
          "id": "grocery-grid-1",
          "type": "product-grid",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "products",
                "endpoint": "product",
                "method": "GET",
                "queryParams": {
                  "size": 8
                }
              }
            ]
          },
          "content": {
            "title": "Featured"
          }
        }
      ]
    },
    "shop": {
      "meta": {
        "title": "Shop"
      },
      "config": [
        {
          "id": "grocery-grid-shop",
          "type": "product-grid",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "products",
                "endpoint": "product",
                "method": "GET",
                "queryParams": {
                  "size": 24
                }
              }
            ]
          },
          "content": {
            "title": "All products"
          }
        }
      ]
    },
    "deals": {
      "meta": {
        "title": "Deals"
      },
      "config": [
        {
          "id": "grocery-grid-deals",
          "type": "product-grid",
          "properties": {
            "level": "base",
            "type": "dynamic",
            "action": [
              {
                "key": "products",
                "endpoint": "product",
                "method": "GET",
                "queryParams": {
                  "size": 24,
                  "on_sale": true
                }
              }
            ]
          },
          "content": {
            "title": "On sale"
          }
        }
      ]
    }
  },
  "site_nav": false,
  "translations": {
    "common.loading": "Loading…",
    "catalog.empty": "No courses yet.",
    "lab.progress": "In progress",
    "lab.complete": "✅ Complete",
    "cart.freeShipping": "Free"
  },
  "roles": [
    {
      "name": "viewer",
      "default": true
    },
    {
      "name": "admin"
    }
  ],
  "rbac": {
    "overview": {
      "read": "*",
      "write": [
        "admin"
      ]
    },
    "category": {
      "read": "*",
      "write": [
        "admin"
      ]
    },
    "product": {
      "read": "*",
      "write": [
        "admin"
      ]
    },
    "customer": {
      "read": "*",
      "write": [
        "admin"
      ]
    },
    "order": {
      "read": "*",
      "write": "*"
    }
  }
