  "language": [
    {
      "name": "English",
      "code": "en"
    },
    {
      "name": "Hindi",
      "code": "hi"
    }
  ],
  "sessions": [
    {
      "name": "cart",
      "persist": true,
      "method": "array_upsert",
      "method_config": {
        "match_key": "id",
        "on_match": "increment",
        "increment_field": "qty",
        "default_fields": {
          "qty": 1
        }
      }
    }
  ],
  "themes": [
    {
      "value": "grocery-light",
      "label": "Grocery Light",
      "endpoint": "style-config/grocery-light"
    },
    {
      "value": "default",
      "label": "Default",
      "endpoint": "style-config/default"
    }
  ],
